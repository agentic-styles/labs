{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.training/schemas/business-acceptance-expected-0.1.json",
  "title": "Booking Precheck Business Acceptance Expected Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "case_id",
    "step_expectations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "suite": {
      "const": "BUSINESS_ACCEPTANCE"
    },
    "case_id": {
      "type": "string",
      "pattern": "^BA-[0-9]{3}$"
    },
    "step_expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stepExpectation"
      }
    }
  },
  "$defs": {
    "stepExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "expected_status",
        "expected_reason_codes",
        "expected_rule_ids",
        "expected_routing_queues",
        "expected_evidence",
        "policy_snapshot_id",
        "audit_assertions"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "expected_status": {
          "enum": [
            "PRECHECK_PASS",
            "REQUIRE_INFORMATION",
            "MANUAL_REVIEW",
            "PRECHECK_BLOCKED"
          ]
        },
        "expected_reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expected_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expected_routing_queues": {
          "type": "array",
          "items": {
            "enum": [
              "DOCUMENT_DESK",
              "DG_DESK",
              "ROUTE_DESK",
              "POLICY_OWNER"
            ]
          },
          "uniqueItems": true
        },
        "expected_required_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "expected_next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_snapshot_id": {
          "type": "string"
        },
        "audit_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditAssertion"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "expected_value"
      ],
      "properties": {
        "fact": {
          "type": "string"
        },
        "expected_value": {},
        "source_document_id": {
          "type": "string"
        }
      }
    },
    "auditAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "PREVIOUS_RESULT_RETAINED",
            "DOCUMENT_VERSION_USED",
            "HUMAN_CONFIRMATION_RECORDED",
            "SNAPSHOT_VERSION_USED",
            "CHANGED_RULE_IDENTIFIED",
            "PRECHECK_NOT_FINAL_APPROVAL"
          ]
        },
        "value": {}
      }
    }
  }
}
