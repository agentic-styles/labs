{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.training/schemas/booking-policy-snapshot-0.2.json",
  "title": "Booking Precheck Policy Snapshot",
  "description": "完全合成的教学承运人规则快照。每条规则必须声明教学目的，且不得暗示真实承运人、港口或监管要求。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "name",
    "carrier_code",
    "route_scope",
    "frozen_at",
    "effective_from",
    "effective_to",
    "training_only",
    "default_status",
    "aggregation_policy",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$",
      "examples": [
        "TRAINING-LINE-CNSHA-AEJEA-2026-08-01"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "carrier_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "examples": [
        "TRAINING-LINE"
      ]
    },
    "route_scope": {
      "$ref": "#/$defs/routeScope"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "training_only": {
      "const": true
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "default_status": {
      "const": "PRECHECK_PASS"
    },
    "aggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_precedence",
        "same_priority_conflict_status",
        "collect_all_matches"
      ],
      "properties": {
        "status_precedence": {
          "const": [
            "PRECHECK_BLOCKED",
            "MANUAL_REVIEW",
            "REQUIRE_INFORMATION",
            "PRECHECK_PASS"
          ]
        },
        "same_priority_conflict_status": {
          "const": "MANUAL_REVIEW"
        },
        "same_priority_conflict_reason_code": {
          "const": "GOV-RULE-CONFLICT"
        },
        "collect_all_matches": {
          "const": true,
          "description": "最终状态按优先级汇总，但输出必须保留全部命中规则与原因。"
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "routeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_of_loading",
        "port_of_discharge",
        "service_codes"
      ],
      "properties": {
        "port_of_loading": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "port_of_discharge": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "facility_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true,
          "default": []
        },
        "service_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "vessel_operator_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "name",
        "description",
        "category",
        "severity",
        "priority",
        "enabled",
        "effective_from",
        "effective_to",
        "scope",
        "condition",
        "action",
        "rule_basis",
        "source"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "enum": [
            "DOCUMENT_COMPLETENESS",
            "CROSS_DOCUMENT_CONSISTENCY",
            "DANGEROUS_GOODS_ACCEPTANCE",
            "ROUTE_AND_PORT",
            "TIMING",
            "GOVERNANCE"
          ]
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "数字越大优先级越高。相同优先级且动作冲突时进入人工复核。"
        },
        "enabled": {
          "type": "boolean"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "$ref": "#/$defs/ruleScope"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "rule_basis": {
          "$ref": "#/$defs/ruleBasis"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uniqueItems": true,
          "default": []
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "ruleBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "teaching_purpose",
        "real_policy_claim"
      ],
      "properties": {
        "type": {
          "const": "SYNTHETIC_TRAINING_POLICY"
        },
        "teaching_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "real_policy_claim": {
          "const": false
        }
      }
    },
    "ruleScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "carrier_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true,
          "default": []
        },
        "port_of_loading": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "port_of_discharge": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{3}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "service_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true,
          "default": []
        },
        "vessel_operator_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "uniqueItems": true,
          "default": []
        },
        "imdg_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9](\\.[1-6])?$"
          },
          "uniqueItems": true,
          "default": []
        },
        "un_numbers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^UN[0-9]{4}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "commodity_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uniqueItems": true,
          "default": []
        },
        "container_types": {
          "type": "array",
          "items": {
            "enum": [
              "20GP",
              "40GP",
              "40HQ",
              "20RF",
              "40RF"
            ]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/allCondition"
        },
        {
          "$ref": "#/$defs/anyCondition"
        },
        {
          "$ref": "#/$defs/notCondition"
        },
        {
          "$ref": "#/$defs/predicate"
        }
      ]
    },
    "allCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      }
    },
    "anyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "operator"
      ],
      "properties": {
        "fact": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.*-]+(\\.[a-zA-Z0-9_.*-]+)*$",
          "description": "相对于 BOOKING_SCHEMA 根对象的事实路径，或以 evaluation 开头的规则评估上下文路径。"
        },
        "operator": {
          "enum": [
            "EXISTS",
            "MISSING",
            "EQUALS",
            "NOT_EQUALS",
            "IN",
            "NOT_IN",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "MATCHES",
            "CONTAINS",
            "DATE_BEFORE",
            "DATE_AFTER",
            "DATE_BETWEEN",
            "OLDER_THAN_MONTHS",
            "WORKING_DAYS_BEFORE",
            "PERCENT_DIFFERENCE_GREATER_THAN"
          ]
        },
        "value": {},
        "compare_to_fact": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.*-]+(\\.[a-zA-Z0-9_.*-]+)*$"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "normalization": {
          "type": "array",
          "items": {
            "enum": [
              "TRIM",
              "UPPERCASE",
              "COLLAPSE_WHITESPACE",
              "REMOVE_PUNCTUATION",
              "UN_NUMBER_CANONICAL",
              "PSN_CANONICAL"
            ]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_status",
        "reason_code",
        "message_template",
        "routing_queue",
        "pause_automation"
      ],
      "properties": {
        "result_status": {
          "enum": [
            "PRECHECK_PASS",
            "REQUIRE_INFORMATION",
            "MANUAL_REVIEW",
            "PRECHECK_BLOCKED"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,79}$"
        },
        "message_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "required_fact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "uniqueItems": true,
          "default": []
        },
        "routing_queue": {
          "enum": [
            "DOCUMENT_DESK",
            "DG_DESK",
            "ROUTE_DESK",
            "POLICY_OWNER",
            null
          ],
          "default": null
        },
        "pause_automation": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "title",
        "authority",
        "verification_status",
        "effective_from",
        "effective_to"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "OFFICIAL_REGULATION",
            "CARRIER_POLICY",
            "PORT_POLICY",
            "INDUSTRY_GUIDANCE",
            "SYNTHETIC_TRAINING_RULE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "evidence_excerpt": {
          "type": "string",
          "maxLength": 2000
        },
        "verification_status": {
          "enum": [
            "VERIFIED_PRIMARY",
            "VERIFIED_SECONDARY",
            "UNVERIFIED",
            "SYNTHETIC"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": "string",
          "format": "date"
        },
        "licensing_note": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
