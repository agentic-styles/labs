{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.training/schemas/business-acceptance-input-0.1.json",
  "title": "Booking Precheck Business Acceptance Input",
  "description": "以现有 Golden Booking Fixture 为基线，通过明确变更描述单步骤或多步骤业务验收场景。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "case_id",
    "title",
    "base_fixture_path",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "suite": {
      "const": "BUSINESS_ACCEPTANCE"
    },
    "case_id": {
      "type": "string",
      "pattern": "^BA-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "base_fixture_path": {
      "type": "string",
      "pattern": "^../../cases/TC-[0-9]{3}/input\\.json$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "actor",
        "trigger",
        "derives_from",
        "mutations"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "actor": {
          "enum": [
            "CUSTOMER",
            "DOCUMENT_REVIEWER",
            "POLICY_OWNER",
            "SYSTEM"
          ]
        },
        "trigger": {
          "enum": [
            "SUBMIT",
            "RESUBMIT",
            "HUMAN_CONFIRM",
            "REPLAY"
          ]
        },
        "derives_from": {
          "description": "BASE_FIXTURE 或同一案例中更早的 step_id；每一步都可以被确定性重建。",
          "type": "string",
          "pattern": "^(BASE_FIXTURE|S[0-9]+)$"
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutation"
          },
          "default": []
        },
        "human_confirmation": {
          "$ref": "#/$defs/humanConfirmation"
        },
        "policy_variant": {
          "$ref": "#/$defs/policyVariant"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mutation": {
      "description": "RFC 6902 风格的教学数据变更；remove 不需要 value。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {}
      }
    },
    "humanConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_role",
        "fact_path",
        "confirmed_value",
        "source_document_id"
      ],
      "properties": {
        "reviewer_role": {
          "enum": [
            "DOCUMENT_REVIEWER",
            "DG_DESK",
            "POLICY_OWNER"
          ]
        },
        "fact_path": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_value": {},
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "policyVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_snapshot_path",
        "snapshot_id",
        "rule_overrides"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^PV-[0-9]{3}$"
        },
        "variant_path": {
          "type": "string",
          "minLength": 1
        },
        "base_snapshot_path": {
          "const": "../../policy_snapshot.json"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "rule_overrides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "action"
            ],
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "result_status",
                  "routing_queue",
                  "pause_automation"
                ],
                "properties": {
                  "result_status": {
                    "enum": [
                      "REQUIRE_INFORMATION",
                      "MANUAL_REVIEW",
                      "PRECHECK_BLOCKED"
                    ]
                  },
                  "routing_queue": {
                    "enum": [
                      "DOCUMENT_DESK",
                      "DG_DESK",
                      "ROUTE_DESK",
                      "POLICY_OWNER",
                      null
                    ]
                  },
                  "pause_automation": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
