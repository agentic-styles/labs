{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.training/schemas/document-ground-truth-0.1.json",
  "title": "Booking Precheck Document Ground Truth",
  "description": "记录合成源单证中的标准字段值及其页码、章节和文本证据，用于分离文档提取错误与规则判断错误。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "case_ref",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^DP-[0-9]{3}$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^(TC|BA)-[0-9]{3}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentTruth"
      }
    }
  },
  "$defs": {
    "documentTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "document_type",
        "document_version",
        "source_path",
        "text_layer_required",
        "facts"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "document_id": {
          "type": "string"
        },
        "document_type": {
          "enum": [
            "BOOKING_REQUEST",
            "PRELIMINARY_DGD",
            "SDS_EXTRACT",
            "POLICY_NOTICE"
          ]
        },
        "document_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_path": {
          "type": "string"
        },
        "expected_page_count": {
          "type": "integer",
          "minimum": 1
        },
        "text_layer_required": {
          "const": true
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factTruth"
          }
        }
      }
    },
    "factTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_path",
        "expected_value",
        "evidence"
      ],
      "properties": {
        "fact_path": {
          "type": "string",
          "minLength": 1
        },
        "expected_value": {},
        "normalization": {
          "type": "array",
          "items": {
            "enum": [
              "TRIM",
              "UPPERCASE",
              "COLLAPSE_WHITESPACE",
              "UN_NUMBER_CANONICAL",
              "PSN_CANONICAL",
              "UNIT_TO_KG",
              "DATE_TO_ISO"
            ]
          },
          "uniqueItems": true,
          "default": []
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "evidence_text"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "evidence_text": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "description": "可选的标准化页面坐标 [x0,y0,x1,y1]；首版不要求。",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
