{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.training/schemas/policy-variant-0.1.json",
  "title": "Synthetic Policy Snapshot Variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant_id",
    "base_snapshot_id",
    "base_snapshot_path",
    "snapshot_id",
    "authorized_by",
    "authorized_at",
    "reason",
    "rule_overrides"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "variant_id": {
      "type": "string",
      "pattern": "^PV-[0-9]{3}$"
    },
    "base_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "base_snapshot_path": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "authorized_by": {
      "const": "TRAINING-LINE Workshop Policy Owner"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "rule_overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "action"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_status",
              "routing_queue",
              "pause_automation"
            ],
            "properties": {
              "result_status": {
                "enum": [
                  "REQUIRE_INFORMATION",
                  "MANUAL_REVIEW",
                  "PRECHECK_BLOCKED"
                ]
              },
              "routing_queue": {
                "enum": [
                  "DOCUMENT_DESK",
                  "DG_DESK",
                  "ROUTE_DESK",
                  "POLICY_OWNER",
                  null
                ]
              },
              "pause_automation": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
